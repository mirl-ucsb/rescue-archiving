    affiliation: "Material / Image Research Lab (MIRL), University of California, Santa Barbara"
  - name: "Material / Image Research Lab (MIRL), University of California, Santa Barbara"
    website: "https://mirl.arthistory.ucsb.edu"
version: "0.1.0"
date-released: "2026-06-01"
license: MIT
